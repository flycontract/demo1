# Sepolia RPC endpoint (Infura, Alchemy, etc.)
RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Deployed FlightDelayInsurance address
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Block the contract was deployed at (used for event replay on a fresh DB;
# irrelevant once oracle.sqlite already has a checkpoint)
DEPLOY_BLOCK=0

# Oracle's own signing key. This account must be set as `oracle` on the
# contract (insurer calls setOracle). It pays gas for fulfillVerification —
# never commit this key or put it in the frontend.
ORACLE_PRIVATE_KEY=0xyourprivatekey

# Where the SQLite evidence/checkpoint database lives
DB_PATH=./oracle.sqlite

# How often to re-scan pending verification requests (ms)
POLL_INTERVAL_MS=60000

# HKIA API request timeout (ms)
HTTP_TIMEOUT_MS=20000

# Max automatic refetches per record-date per calendar day (PRD §6)
MAX_DAILY_REFRESH=3
